# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth

# Model Provider: ollama | anthropic | openai | demo
MODEL_PROVIDER=ollama

# Ollama (default local demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Providers (set when using cloud)
CLOUD_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings: ollama | openai | hash (hash = deterministic demo fallback)
EMBEDDINGS_PROVIDER=ollama

# Demo fallback when Ollama unavailable (clearly labeled responses)
DEMO_FALLBACK_ENABLED=true

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.15
EMBEDDING_DIMENSION=768

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=120
RAG_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
